# Copy to .env and adjust.

PORT=8787
DB_PATH=./data/imgrouter.db
IMAGES_DIR=./data/images

# Gemini image generation ("Nano Banana")
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Character consistency: set "refImagePath" (server-side path to a PNG/JPG) when creating
# a project to run image-to-image edits. gemini-2.5-flash-image accepts up to 3 references.

# Quota / pacing defaults
DEFAULT_DAY_LIMIT=5
MAX_INFLIGHT_PER_KEY=1
RPM_PER_KEY=5
MAX_ATTEMPTS=3

# Daily reset boundary. Minutes offset from UTC for the provider reset time.
# Google free tier resets ~midnight US Pacific: PDT (UTC-7) = -420, PST (UTC-8) = -480.
RESET_TZ_OFFSET_MINUTES=-420

# Dispatcher
DISPATCHER_INTERVAL_MS=15000
RATE_LIMIT_COOLDOWN_MS=45000
# A job left in 'running' longer than this (e.g. the process crashed) is re-queued.
LEASE_TIMEOUT_MS=120000

# Test mode: leave empty for real calls.
#   ok    -> succeed without network
#   quota -> return quota_exhausted for every call
#   rate  -> return rate_limited for every call
MOCK_GEMINI=
